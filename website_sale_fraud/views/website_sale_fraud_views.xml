<odoo>
    <data>
        <!--
            capture.flow views
        -->
        <record id="capture_flow_tree" model="ir.ui.view">
            <field name="name">capture.flow.tree</field>
            <field name="model">capture.flow</field>
            <field name="arch" type="xml">
                <tree string="Payment Auto Capture" decoration-danger="not active">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active" optional="hide"/>
                    <field name="action" optional="hide"/>
                    <!-- Yes Flow -->
                    <field name="yes_show_mail_template" optional="hide"/>
                    <field name="yes_mail_template_id" optional="hide"/>
                    <field name="yes_tag_id" optional="hide"/>
                    <field name="yes_message" optional="hide"/>
                    <!-- No Flow -->
                    <field name="no_show_mail_template" optional="hide"/>
                    <field name="no_mail_template_id" optional="hide"/>
                    <field name="no_tag_id" optional="hide"/>
                    <field name="no_message" optional="hide"/>
                    <!-- -->
                    <field name="expression" invisible="action != 'decision'" required="action == 'decision'"/>
                    <field name="yes_id" invisible="action != 'decision'" required="action == 'decision'"/>
                    <field name="no_id" invisible="action != 'decision'"/>
                </tree>
            </field>
        </record>

        <record id="capture_flow_search" model="ir.ui.view">
            <field name="name">capture.flow.search</field>
            <field name="model">capture.flow</field>
            <field name="arch" type="xml">
                <search string="Payment Auto Capture">
                    <field name="name"/>
                    <field name="expression"/>
                    <field name="yes_id"/>
                    <field name="no_id"/>
                </search>
            </field>
        </record>

        <record id="capture_flow_form" model="ir.ui.view">
            <field name="name">capture.flow.form</field>
            <field name="model">capture.flow</field>
            <field name="arch" type="xml">
                <form string="Payment Auto Capture">
                    <group>
                        <field name="action" invisible="1"/>
                        <field name="yes_show_mail_template" string="Show Mail Template" invisible="1"/>
                        <field name="no_show_mail_template" string="Show Mail Template" invisible="1"/>
                        <field name="name"/>
                        <field name="expression" widget="code" options="{'mode': 'python'}" invisible="action != 'decision'" required="action == 'decision'"/>
                        <group name="yes_flow" string="If Yes">
                            <field name="yes_id" string="Flow" invisible="action != 'decision'" required="action == 'decision'" options="{'no_create': True, 'no_open': True}"/>
                            <field name="yes_mail_template_id" string="Email Template" invisible="not yes_show_mail_template" required="yes_show_mail_template" options="{'no_create': True, 'no_open': True}"/>
                            <field name="yes_tag_id" string="SO Tag" options="{'no_create': True, 'no_open': True}"/>
                            <field name="yes_message" string="Log Message"/>
                        </group>
                        <group name="no_flow" string="If No">
                            <field name="no_id" string="Flow" invisible="action != 'decision'" required="action == 'decision'" options="{'no_create': True, 'no_open': True}"/>
                            <field name="no_mail_template_id" string="Email Template" invisible="not no_show_mail_template" required="no_show_mail_template" options="{'no_create': True, 'no_open': True}"/>
                            <field name="no_tag_id" string="SO Tag" options="{'no_create': True, 'no_open': True}"/>
                            <field name="no_message" string="Log Message"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="website_fraud_rules_action">
            <field name="name">Website Fraud Rules</field>
            <field name="res_model">capture.flow</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="capture_flow_tree"/>
            <field name="domain">[('action', '=', 'decision')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Rule
                </p>
            </field>
        </record>

        <menuitem
            id="menu_website_fraud"
            name="Website Fraud"
            parent="website_sale.menu_ecommerce"
            groups="sales_team.group_sale_manager"
            sequence="100">

        <menuitem id="menu_website_fraud_rules"
            action="website_sale_fraud.website_fraud_rules_action"/>

        </menuitem>

    </data>
</odoo>
