<odoo>
    <data noupdate="0">

        <record forcecreate="True" id="capture_flow_capture_payment" model="capture.flow">
            <field name="name">Capture Payment</field>
            <field name="action">capture</field>
            <field name="sequence">1</field>
            <field name="active" eval="False"/>
        </record>

        <record forcecreate="True" id="capture_flow_ask_for_review" model="capture.flow">
            <field name="name">Ask for Review</field>
            <field name="action">review</field>
            <field name="sequence">2</field>
            <field name="active" eval="False"/>
        </record>

        <record forcecreate="True" id="capture_flow_send_email" model="capture.flow">
            <field name="name">Send Email</field>
            <field name="action">send_email</field>
            <field name="sequence">3</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
